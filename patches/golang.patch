+package presentation
+
+import (
+	"fmt"
+
+	assetusecase "folio/codinginterview/internal/application/usecase/asset"
+	"folio/codinginterview/internal/domain"
+)
+
+type StockHolderDto struct {
+	UserId    string
+	AmountJpy string
+}
+
+type StockHolderReportDto struct {
+	Symbol  string
+	Holders []StockHolderDto
+}
+
+type GenerateStockHolderReportRequest struct {
+	SymbolToUsers map[string][]string
+}
+
+type GenerateStockHolderReportResponse struct {
+	Reports []StockHolderReportDto
+}
+
+type BatchAssetController struct {
+	generateStockHolderReportUsecase *assetusecase.GenerateStockHolderReportUsecase
+}
+
+func NewBatchAssetController(
+	generateStockHolderReportUsecase *assetusecase.GenerateStockHolderReportUsecase,
+) *BatchAssetController {
+	return &BatchAssetController{generateStockHolderReportUsecase: generateStockHolderReportUsecase}
+}
+
+// バッチ処理用に、銘柄を保有している顧客・口座一覧を出力する
+func (c *BatchAssetController) GenerateStockHolderReport(
+	req GenerateStockHolderReportRequest,
+) (GenerateStockHolderReportResponse, error) {
+	symbolToUsers := make(map[domain.StockSymbol][]domain.UserId)
+	for rawSymbol, rawUserIds := range req.SymbolToUsers {
+		symbol, err := domain.StockSymbolFromString(rawSymbol)
+		if err != nil {
+			return GenerateStockHolderReportResponse{}, newBadRequest(fmt.Sprintf("unknown symbol: %s", rawSymbol))
+		}
+
+		userIds := make([]domain.UserId, 0, len(rawUserIds))
+		for _, rawUserId := range rawUserIds {
+			userId, err := parseUserId(rawUserId)
+			if err != nil {
+				return GenerateStockHolderReportResponse{}, err
+			}
+			userIds = append(userIds, userId)
+		}
+		symbolToUsers[symbol] = userIds
+	}
+
+	reports, err := c.generateStockHolderReportUsecase.Run(symbolToUsers)
+	if err != nil {
+		return GenerateStockHolderReportResponse{}, err
+	}
+
+	reportDtos := make([]StockHolderReportDto, 0, len(reports))
+	for _, report := range reports {
+		holders := make([]StockHolderDto, 0, len(report.Holders))
+		for _, h := range report.Holders {
+			holders = append(holders, StockHolderDto{
+				UserId:    h.UserId.Value,
+				AmountJpy: h.AmountJpy.String(),
+			})
+		}
+		reportDtos = append(reportDtos, StockHolderReportDto{
+			Symbol:  string(report.Symbol),
+			Holders: holders,
+		})
+	}
+
+	return GenerateStockHolderReportResponse{Reports: reportDtos}, nil
+}
