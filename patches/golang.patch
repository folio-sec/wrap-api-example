+package asset
+
+import (
+	"folio/codinginterview/internal/application/repository"
+	"folio/codinginterview/internal/domain"
+)
+
+type GenerateStockHolderReportUsecase struct {
+	accountRepo repository.AccountRepository
+}
+
+func NewGenerateStockHolderReportUsecase(accountRepo repository.AccountRepository) *GenerateStockHolderReportUsecase {
+	return &GenerateStockHolderReportUsecase{accountRepo: accountRepo}
+}
+
+func (u *GenerateStockHolderReportUsecase) Run(symbolToUsers map[domain.StockSymbol][]domain.UserId) ([]StockHolderReport, error) {
+	entries, err := u.accountRepo.FindAll()
+	if err != nil {
+		return nil, err
+	}
+
+	accounts := make([]UserAccount, 0, len(entries))
+	for _, e := range entries {
+		accounts = append(accounts, UserAccount{UserId: e.UserId, Account: e.Account})
+	}
+
+	return Join(accounts, symbolToUsers), nil
+}
