@@ -0,0 +1,77 @@
+package test
+
+import (
+	"reflect"
+	"testing"
+
+	"folio/codinginterview/internal/infrastructure/server"
+	"folio/codinginterview/internal/presentation"
+)
+
+func TestBatchAssetScenario(t *testing.T) {
+	server := server.NewDefaultDummyServer()
+	user1 := "user-1"
+	user2 := "user-2"
+
+	t.Log("Given: 最適ポートフォリオを Toyopa 100% にする")
+	err := server.PortfolioController.UpdateOptimalPortfolio(presentation.UpdateOptimalPortfolioRequest{
+		Portfolios: []presentation.PortfolioItemDto{
+			{Symbol: "Toyopa", Rate: "1.0"},
+		},
+	})
+	if err != nil {
+		t.Fatalf("UpdateOptimalPortfolio failed: %v", err)
+	}
+
+	t.Log("And: user1 が新規拠出する")
+	err = server.OrderController.NewOrder(presentation.NewOrderRequest{UserId: user1, Amount: "100000"})
+	if err != nil {
+		t.Fatalf("NewOrder failed: %v", err)
+	}
+
+	t.Log("And: 最適ポートフォリオを Toyopa 40%・Somy 60% にする")
+	err = server.PortfolioController.UpdateOptimalPortfolio(presentation.UpdateOptimalPortfolioRequest{
+		Portfolios: []presentation.PortfolioItemDto{
+			{Symbol: "Toyopa", Rate: "0.40"},
+			{Symbol: "Somy", Rate: "0.60"},
+		},
+	})
+	if err != nil {
+		t.Fatalf("UpdateOptimalPortfolio failed: %v", err)
+	}
+
+	t.Log("And: user2 が新規拠出する")
+	err = server.OrderController.NewOrder(presentation.NewOrderRequest{UserId: user2, Amount: "200000"})
+	if err != nil {
+		t.Fatalf("NewOrder failed: %v", err)
+	}
+
+	t.Log("When: generateStockHolderReport を呼び出す")
+	response, err := server.BatchAssetController.GenerateStockHolderReport(presentation.GenerateStockHolderReportRequest{
+		SymbolToUsers: map[string][]string{
+			"Toyopa": {user1, user2},
+			"Somy":   {user1, user2},
+		},
+	})
+	if err != nil {
+		t.Fatalf("GenerateStockHolderReport failed: %v", err)
+	}
+
+	t.Log("Then: 結果を Map でそのまま確認する")
+	reports := make(map[string][]presentation.StockHolderDto)
+	for _, report := range response.Reports {
+		reports[report.Symbol] = report.Holders
+	}
+	want := map[string][]presentation.StockHolderDto{
+		"Toyopa": {
+			{UserId: user1, AmountJpy: "95000"},
+			{UserId: user2, AmountJpy: "76000"},
+		},
+		"Somy": {
+			{UserId: user2, AmountJpy: "114000"},
+		},
+	}
+	if !reflect.DeepEqual(reports, want) {
+		t.Fatalf("reports mismatch:\ngot:  %#v\nwant: %#v", reports, want)
+	}
+}
