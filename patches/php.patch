+<?php
+
+declare(strict_types=1);
+
+namespace Folio\CodingInterview\Presentation;
+
+use Folio\CodingInterview\Application\Usecase\Asset\GenerateStockHolderReportUsecase;
+use Folio\CodingInterview\Domain\StockSymbol;
+
+final class GenerateStockHolderReportRequest
+{
+    /** @param array<string, string[]> $symbolToUsers */
+    public function __construct(public readonly array $symbolToUsers) {}
+}
+
+final class StockHolderDto
+{
+    public function __construct(
+        public readonly string $userId,
+        public readonly string $amountJpy,
+    ) {}
+}
+
+final class StockHolderReportDto
+{
+    /** @param StockHolderDto[] $holders */
+    public function __construct(
+        public readonly string $symbol,
+        public readonly array $holders,
+    ) {}
+}
+
+final class GenerateStockHolderReportResponse
+{
+    /** @param StockHolderReportDto[] $reports */
+    public function __construct(public readonly array $reports) {}
+}
+
+final class BatchAssetController
+{
+    use PresentationPreparation;
+
+    public function __construct(
+        private readonly GenerateStockHolderReportUsecase $generateStockHolderReportUsecase,
+    ) {}
+
+    /** バッチ処理用に、銘柄を保有している顧客・口座一覧を出力する */
+    public function generateStockHolderReport(GenerateStockHolderReportRequest $req): GenerateStockHolderReportResponse
+    {
+        $symbolToUsers = [];
+        foreach ($req->symbolToUsers as $rawSymbol => $rawUserIds) {
+            $symbol = StockSymbol::fromStringOrNull((string) $rawSymbol);
+            if ($symbol === null) {
+                throw new BadRequestException("unknown symbol: {$rawSymbol}");
+            }
+            $userIds = [];
+            foreach ($rawUserIds as $rawUserId) {
+                $userIds[] = $this->parseUserId($rawUserId);
+            }
+            $symbolToUsers[$symbol->value] = $userIds;
+        }
+
+        $reports = $this->generateStockHolderReportUsecase->run($symbolToUsers);
+
+        $reportDtos = [];
+        foreach ($reports as $report) {
+            $holders = [];
+            foreach ($report->holders as $h) {
+                $holders[] = new StockHolderDto($h->userId->value, $h->amountJpy->toString());
+            }
+            $reportDtos[] = new StockHolderReportDto($report->symbol->value, $holders);
+        }
+        return new GenerateStockHolderReportResponse($reportDtos);
+    }
+}
