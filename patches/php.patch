@@ -0,0 +1,81 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Folio\CodingInterview\Application\Usecase\Asset;
+
+use Folio\CodingInterview\Domain\Account;
+use Folio\CodingInterview\Domain\BigDecimal;
+use Folio\CodingInterview\Domain\StockSymbol;
+use Folio\CodingInterview\Domain\UserId;
+
+final class UserAccount
+{
+    public function __construct(
+        public readonly UserId $userId,
+        public readonly Account $account,
+    ) {}
+}
+
+final class StockHolder
+{
+    public function __construct(
+        public readonly UserId $userId,
+        public readonly BigDecimal $amountJpy,
+    ) {}
+}
+
+final class StockHolderReport
+{
+    /** @param StockHolder[] $holders */
+    public function __construct(
+        public readonly StockSymbol $symbol,
+        public readonly array $holders,
+    ) {}
+}
+
+final class StockHolderJoiner
+{
+    /**
+     * 全口座情報と、銘柄を保有する顧客マッピング情報をもとに、銘柄を保持する顧客・口座一覧情報を返却する
+     * @param UserAccount[] $accounts 全口座一覧
+     * @param array<string, UserId[]> $symbolToUsers 銘柄を保有する顧客マッピング情報
+     * @return StockHolderReport[] 銘柄を保持する顧客・口座一覧情報
+     */
+    public static function join(array $accounts, array $symbolToUsers): array
+    {
+        $results = [];
+        foreach ($symbolToUsers as $symbol => $userIds) {
+            $symbol = StockSymbol::from($symbol);
+            $holders = [];
+            foreach ($userIds as $userId) {
+                $maybeAccount = null;
+                foreach ($accounts as $a) {
+                    if ($a->userId->value === $userId->value) {
+                        $maybeAccount = $a;
+                        break;
+                    }
+                }
+                if ($maybeAccount !== null) {
+                    $userAccount = $maybeAccount;
+                    $stock = null;
+                    foreach ($userAccount->account->stocks as $s) {
+                        if ($s->symbol === $symbol) {
+                            $stock = $s;
+                            break;
+                        }
+                    }
+                    if ($stock !== null) {
+                        $holders[] = new StockHolder($userId, $stock->amountJpy);
+                    } else {
+                        // 何もしない
+                    }
+                } else {
+                    // 何もしない
+                }
+            }
+            $results[] = new StockHolderReport($symbol, $holders);
+        }
+        return $results;
+    }
+}
