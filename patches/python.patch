+from coding_interview.infrastructure.server.dummy_server import DummyServer
+from coding_interview.presentation.batch_asset_controller import (
+    GenerateStockHolderReportRequest,
+    StockHolderDto,
+)
+from coding_interview.presentation.order_controller import NewOrderRequest
+from coding_interview.presentation.portfolio_controller import PortfolioItemDto, UpdateOptimalPortfolioRequest
+
+
+def test_batch_asset_report_scenario() -> None:
+    """Batch Asset Report: 銘柄毎に保有している顧客・口座一覧を出力する"""
+    server = DummyServer.default()
+    user1 = "user-1"
+    user2 = "user-2"
+
+    # Given: 最適ポートフォリオを Toyopa 100% にする
+    server.portfolio_controller.update_optimal_portfolio(
+        UpdateOptimalPortfolioRequest(portfolios=(PortfolioItemDto("Toyopa", "1.0"),))
+    )
+
+    # And: user1 が新規拠出する
+    server.order_controller.new_order(NewOrderRequest(user1, "100000"))
+
+    # And: 最適ポートフォリオを Toyopa 40%・Somy 60% にする
+    server.portfolio_controller.update_optimal_portfolio(
+        UpdateOptimalPortfolioRequest(
+            portfolios=(PortfolioItemDto("Toyopa", "0.40"), PortfolioItemDto("Somy", "0.60"))
+        )
+    )
+
+    # And: user2 が新規拠出する
+    server.order_controller.new_order(NewOrderRequest(user2, "200000"))
+
+    # When: generateStockHolderReport を呼び出す
+    response = server.batch_asset_controller.generate_stock_holder_report(
+        GenerateStockHolderReportRequest(
+            symbolToUsers={"Toyopa": [user1, user2], "Somy": [user1, user2]}
+        )
+    )
+
+    # Then: 結果を Map でそのまま確認する
+    reports = {report.symbol: report.holders for report in response.reports}
+    assert reports == {
+        "Toyopa": (StockHolderDto(user1, "95000"), StockHolderDto(user2, "76000")),
+        "Somy": (StockHolderDto(user2, "114000"),),
+    }
