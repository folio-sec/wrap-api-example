+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from coding_interview.application.usecase.asset.generate_stock_holder_report_usecase import (
+    GenerateStockHolderReportUsecase,
+)
+from coding_interview.domain.stock_symbol import StockSymbol
+from coding_interview.domain.user_id import UserId
+from coding_interview.presentation.exceptions import BadRequestException
+from coding_interview.presentation.preparation import parse_user_id
+
+
+@dataclass(frozen=True)
+class GenerateStockHolderReportRequest:
+    symbolToUsers: dict[str, list[str]]
+
+
+@dataclass(frozen=True)
+class StockHolderDto:
+    userId: str
+    amountJpy: str
+
+
+@dataclass(frozen=True)
+class StockHolderReportDto:
+    symbol: str
+    holders: tuple[StockHolderDto, ...]
+
+
+@dataclass(frozen=True)
+class GenerateStockHolderReportResponse:
+    reports: tuple[StockHolderReportDto, ...]
+
+
+class BatchAssetController:
+    def __init__(
+        self, generate_stock_holder_report_usecase: GenerateStockHolderReportUsecase
+    ) -> None:
+        self._generate_stock_holder_report_usecase = generate_stock_holder_report_usecase
+
+    def generate_stock_holder_report(
+        self, req: GenerateStockHolderReportRequest
+    ) -> GenerateStockHolderReportResponse:
+        """バッチ処理用に、銘柄を保有している顧客・口座一覧を出力する"""
+        symbol_to_users: dict[StockSymbol, list[UserId]] = {}
+        for raw_symbol, raw_user_ids in req.symbolToUsers.items():
+            symbol = StockSymbol.from_string(raw_symbol)
+            if symbol is None:
+                raise BadRequestException(f"unknown symbol: {raw_symbol}")
+            user_ids = [parse_user_id(raw_user_id) for raw_user_id in raw_user_ids]
+            symbol_to_users[symbol] = user_ids
+
+        reports = self._generate_stock_holder_report_usecase.run(symbol_to_users)
+        return GenerateStockHolderReportResponse(
+            reports=tuple(
+                StockHolderReportDto(
+                    symbol=str(report.symbol),
+                    holders=tuple(
+                        StockHolderDto(userId=h.user_id.value, amountJpy=str(h.amount_jpy))
+                        for h in report.holders
+                    ),
+                )
+                for report in reports
+            )
+        )
