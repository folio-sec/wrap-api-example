+from __future__ import annotations
+
+from coding_interview.application.repository.account_repository import AccountRepository
+from coding_interview.application.usecase.asset.stock_holder_joiner import (
+    StockHolderReport,
+    UserAccount,
+    join,
+)
+from coding_interview.domain.stock_symbol import StockSymbol
+from coding_interview.domain.user_id import UserId
+
+
+class GenerateStockHolderReportUsecase:
+    def __init__(self, account_repository: AccountRepository) -> None:
+        self._account_repository = account_repository
+
+    def run(
+        self, symbol_to_users: dict[StockSymbol, list[UserId]]
+    ) -> list[StockHolderReport]:
+        accounts = self._account_repository.find_all()
+        return join(
+            [UserAccount(user_id, account) for user_id, account in accounts],
+            symbol_to_users,
+        )
