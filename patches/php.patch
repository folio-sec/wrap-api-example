+<?php
+
+declare(strict_types=1);
+
+namespace Folio\CodingInterview\Tests;
+
+use Folio\CodingInterview\Infrastructure\Server\DummyServer;
+use Folio\CodingInterview\Presentation\GenerateStockHolderReportRequest;
+use Folio\CodingInterview\Presentation\NewOrderRequest;
+use Folio\CodingInterview\Presentation\PortfolioItemDto;
+use Folio\CodingInterview\Presentation\StockHolderDto;
+use Folio\CodingInterview\Presentation\UpdateOptimalPortfolioRequest;
+use PHPUnit\Framework\TestCase;
+
+final class BatchAssetScenarioTest extends TestCase
+{
+    public function test銘柄毎に保有している顧客・口座一覧を出力する(): void
+    {
+        $server = DummyServer::default();
+        $user1 = 'user-1';
+        $user2 = 'user-2';
+
+        // Given: 最適ポートフォリオを Toyopa 100% にする
+        $server->portfolioController->updateOptimalPortfolio(new UpdateOptimalPortfolioRequest([
+            new PortfolioItemDto('Toyopa', '1.0'),
+        ]));
+
+        // And: user1 が新規拠出する
+        $server->orderController->newOrder(new NewOrderRequest($user1, '100000'));
+
+        // And: 最適ポートフォリオを Toyopa 40%・Somy 60% にする
+        $server->portfolioController->updateOptimalPortfolio(new UpdateOptimalPortfolioRequest([
+            new PortfolioItemDto('Toyopa', '0.40'),
+            new PortfolioItemDto('Somy', '0.60'),
+        ]));
+
+        // And: user2 が新規拠出する
+        $server->orderController->newOrder(new NewOrderRequest($user2, '200000'));
+
+        // When: generateStockHolderReport を呼び出す
+        $response = $server->batchAssetController->generateStockHolderReport(
+            new GenerateStockHolderReportRequest([
+                'Toyopa' => [$user1, $user2],
+                'Somy' => [$user1, $user2],
+            ])
+        );
+
+        // Then: 結果を Map でそのまま確認する
+        $reports = [];
+        foreach ($response->reports as $report) {
+            $reports[$report->symbol] = $report->holders;
+        }
+        $this->assertEquals([
+            'Toyopa' => [new StockHolderDto($user1, '95000'), new StockHolderDto($user2, '76000')],
+            'Somy' => [new StockHolderDto($user2, '114000')],
+        ], $reports);
+    }
+}
