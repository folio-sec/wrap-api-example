@@ -0,0 +1,29 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Folio\CodingInterview\Application\Usecase\Asset;
+
+use Folio\CodingInterview\Application\Repository\AccountRepository;
+
+final class GenerateStockHolderReportUsecase
+{
+    public function __construct(
+        private readonly AccountRepository $accountRepository,
+    ) {}
+
+    /**
+     * @param array<string, \Folio\CodingInterview\Domain\UserId[]> $symbolToUsers
+     * @return StockHolderReport[]
+     */
+    public function run(array $symbolToUsers): array
+    {
+        return StockHolderJoiner::join(
+            array_map(
+                fn(array $pair): UserAccount => new UserAccount($pair[0], $pair[1]),
+                $this->accountRepository->findAll(),
+            ),
+            $symbolToUsers,
+        );
+    }
+}
