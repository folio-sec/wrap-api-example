@@ -0,0 +1,61 @@
+package asset
+
+import (
+	"folio/codinginterview/internal/domain"
+
+	"github.com/shopspring/decimal"
+)
+
+type UserAccount struct {
+	UserId  domain.UserId
+	Account domain.Account
+}
+
+type StockHolder struct {
+	UserId    domain.UserId
+	AmountJpy decimal.Decimal
+}
+
+type StockHolderReport struct {
+	Symbol  domain.StockSymbol
+	Holders []StockHolder
+}
+
+// 全口座情報と、銘柄を保有する顧客マッピング情報をもとに、銘柄を保持する顧客・口座一覧情報を返却する
+// @param accounts 全口座一覧
+// @param symbolToUsers 銘柄を保有する顧客マッピング情報
+// @return 銘柄を保持する顧客・口座一覧情報
+func Join(accounts []UserAccount, symbolToUsers map[domain.StockSymbol][]domain.UserId) []StockHolderReport {
+	results := make([]StockHolderReport, 0)
+	for symbol, userIds := range symbolToUsers {
+		holders := make([]StockHolder, 0)
+		for _, userId := range userIds {
+			var maybeAccount *UserAccount
+			for i := range accounts {
+				if accounts[i].UserId == userId {
+					maybeAccount = &accounts[i]
+					break
+				}
+			}
+			if maybeAccount != nil {
+				userAccount := *maybeAccount
+				var stock *domain.Stock
+				for i := range userAccount.Account.Stocks {
+					if userAccount.Account.Stocks[i].Symbol == symbol {
+						stock = &userAccount.Account.Stocks[i]
+						break
+					}
+				}
+				if stock != nil {
+					holders = append(holders, StockHolder{UserId: userId, AmountJpy: stock.AmountJpy})
+				} else {
+					// 何もしない
+				}
+			} else {
+				// 何もしない
+			}
+		}
+		results = append(results, StockHolderReport{Symbol: symbol, Holders: holders})
+	}
+	return results
+}
