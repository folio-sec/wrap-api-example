@@ -0,0 +1,54 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from decimal import Decimal
+
+from coding_interview.domain.account import Account
+from coding_interview.domain.stock_symbol import StockSymbol
+from coding_interview.domain.user_id import UserId
+
+
+@dataclass(frozen=True)
+class UserAccount:
+    user_id: UserId
+    account: Account
+
+
+@dataclass(frozen=True)
+class StockHolder:
+    user_id: UserId
+    amount_jpy: Decimal
+
+
+@dataclass(frozen=True)
+class StockHolderReport:
+    symbol: StockSymbol
+    holders: list[StockHolder]
+
+
+def join(
+    accounts: list[UserAccount], symbol_to_users: dict[StockSymbol, list[UserId]]
+) -> list[StockHolderReport]:
+    """全口座情報と、銘柄を保有する顧客マッピング情報をもとに、銘柄を保持する顧客・口座一覧情報を返却する
+    @param accounts 全口座一覧
+    @param symbol_to_users 銘柄を保有する顧客マッピング情報
+    @return 銘柄を保持する顧客・口座一覧情報
+    """
+    results: list[StockHolderReport] = []
+    for symbol, user_ids in symbol_to_users.items():
+        holders: list[StockHolder] = []
+        for user_id in user_ids:
+            maybe_account = next((a for a in accounts if a.user_id == user_id), None)
+            if maybe_account is not None:
+                user_account = maybe_account
+                stock = next(
+                    (s for s in user_account.account.stocks if s.symbol == symbol), None
+                )
+                if stock is not None:
+                    holders.append(StockHolder(user_id, stock.amount_jpy))
+                else:
+                    pass  # 何もしない
+            else:
+                pass  # 何もしない
+        results.append(StockHolderReport(symbol, holders))
+    return results
